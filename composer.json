{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "omarsenusi/laravel-marketplace-platforms",
    "description": "Salla and Zid integration for Laravel: easy-mode OAuth, token storage and refresh, verified webhook ingress, store provisioning and claim links, catalog and order readers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "salla", "zid", "ecommerce", "marketplace", "oauth", "webhooks"],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Omarsenusi\\MarketplacePlatforms\\": "src/",
            "Omarsenusi\\MarketplacePlatforms\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omarsenusi\\MarketplacePlatforms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omarsenusi\\MarketplacePlatforms\\PlatformsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
